{
  "description": "Code Team: SessionStart waits up to 12 seconds for the local gateway, then exits 0 and may ask for a retry while startup finishes in the background",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/registry-writer.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/code-team.js\" ensure --quiet",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
